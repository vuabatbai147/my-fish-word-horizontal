rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEV ACL: người dùng chỉ có thể đọc quyền CỦA CHÍNH MÌNH.
    // Không cho client tạo, sửa hoặc xóa quyền DEV.
    // Chủ project cấp quyền từ Firebase Console (Admin SDK cũng bỏ qua Rules).
    match /dev_accounts/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /users/{uid}/saves/{saveId} {
      allow read: if request.auth != null && request.auth.uid == uid && saveId == 'main';
      allow create, update: if request.auth != null && request.auth.uid == uid
        && saveId == 'main'
        && request.resource.data.keys().hasOnly(['gameState','schemaVersion','updatedAt'])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.gameState is map
        && request.resource.data.gameState.v == 2
        && request.resource.data.size() < 800000;
      allow delete: if false;
    }
  }
}
